rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated and accessing own data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if user has an authorized admin email or record
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          'founder@neubofy.in',
          'pawanwashudev@gmail.com'
        ] ||
        request.auth.token.email.matches('.*@neubofy[.]in$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Match all documents under users
    match /users/{userId} {
      // User can read and write own document; Admins can read and update for recruitment orchestration
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // Subcollections
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admin configuration collection
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Default deny for everything else (high stake security)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
