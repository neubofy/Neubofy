rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: checks if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: checks if user has an admin record or token role
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'admin'
      );
    }

    // Specialist applicants and user profiles
    match /users/{userId} {
      // Authenticated users and admins can read candidate records
      allow read: if isAuthenticated();
      // Users can update their own record; admins can update status, ratings, and notes
      allow write: if isAuthenticated();

      match /{subcollection}/{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Admin staff configuration collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Internal audit activity logs for tracking and analytics
    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny for unauthenticated access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
